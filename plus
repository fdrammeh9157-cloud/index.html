<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Astral Hub</title>
  <style>
    * { box-sizing: border-box; }

    :root {
      color-scheme: dark;
      --bg: #090b18;
      --panel: rgba(22, 26, 49, .82);
      --card: rgba(30, 35, 65, .82);
      --text: #f3f4ff;
      --muted: #a9aecb;
      --accent: #9c8cff;
      --line: rgba(190, 185, 255, .16);
    }

    body {
      margin: 0;
      min-height: 100vh;
      padding: 34px 22px 28px;
      color: var(--text);
      font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
      background:
        radial-gradient(ellipse at 15% 10%, rgba(108, 79, 205, .28), transparent 35%),
        radial-gradient(ellipse at 85% 20%, rgba(43, 123, 194, .18), transparent 32%),
        var(--bg);
    }

    main { width: min(940px, 100%); margin: 0 auto; }

    header { margin: 34px 0 26px; }
    .eyebrow {
      color: #b6aaff;
      font-size: .78rem;
      font-weight: 700;
      letter-spacing: .18em;
      text-transform: uppercase;
    }

    h1 { margin: 8px 0; font-size: clamp(2.2rem, 7vw, 3.5rem); }
    header p, .subheading { color: var(--muted); }

    .search {
      display: flex;
      gap: 10px;
      padding: 10px;
      border: 1px solid var(--line);
      border-radius: 18px;
      background: var(--panel);
      box-shadow: 0 16px 50px rgba(0, 0, 0, .24);
      backdrop-filter: blur(12px);
    }

    input, select, button {
      min-height: 48px;
      border: 0;
      border-radius: 12px;
      font: inherit;
    }

    input, select {
      color: var(--text);
      background: rgba(255, 255, 255, .07);
    }

    select { padding: 0 12px; }
    input { flex: 1; min-width: 0; padding: 0 14px; outline: none; }
    input:focus { box-shadow: 0 0 0 2px var(--accent); }

    button {
      padding: 0 20px;
      color: #100d25;
      background: linear-gradient(135deg, #c0aaff, #8b9cff);
      font-weight: 750;
      cursor: pointer;
    }

    button:hover, .card:hover { transform: translateY(-2px); }
    button, .card { transition: transform .18s ease, border-color .18s ease; }

    section { margin-top: 34px; }
    h2 { margin: 0 0 13px; font-size: 1.15rem; }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(155px, 1fr));
      gap: 12px;
    }

    .card {
      display: flex;
      align-items: center;
      gap: 12px;
      min-height: 76px;
      padding: 15px;
      color: var(--text);
      text-align: left;
      text-decoration: none;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: var(--card);
    }

    .card:hover { border-color: rgba(192, 170, 255, .55); }
    .icon {
      display: grid;
      width: 40px;
      height: 40px;
      flex: 0 0 40px;
      place-items: center;
      border-radius: 12px;
      background: rgba(177, 157, 255, .14);
      font-size: 1.25rem;
    }

    .card strong { display: block; }
    .card small { color: var(--muted); }

    footer {
      margin-top: 42px;
      padding-top: 18px;
      color: var(--muted);
      border-top: 1px solid var(--line);
      font-size: .8rem;
      line-height: 1.5;
    }

    @media (max-width: 560px) {
      body { padding: 22px 15px; }
      .search { flex-wrap: wrap; }
      select { flex: 1; }
      .search button { width: 100%; }
    }
  </style>
</head>
<body>
  <main>
    <header>
      <div class="eyebrow">Your launchpad</div>
      <h1>✦ Astral Hub</h1>
      <p>Your favorite websites, all in one place.</p>
    </header>

    <form class="search" id="searchForm">
      <select id="engine" aria-label="Choose a search engine">
        <option value="https://search.brave.com/search?q=">Brave Search</option>
        <option value="https://duckduckgo.com/?q=">DuckDuckGo</option>
        <option value="https://www.startpage.com/sp/search?query=">Startpage</option>
        <option value="https://www.ecosia.org/search?q=">Ecosia</option>
      </select>
      <input id="query" type="search" placeholder="Search the web…" required>
      <button type="submit">Search</button>
    </form>

    <section>
      <h2>Watch & Connect</h2>
      <div class="grid">
        <a class="card" href="https://www.youtube.com/">
          <span class="icon">▶</span><span><strong>YouTube</strong><small>Videos</small></span>
        </a>
        <a class="card" href="https://www.tiktok.com/">
          <span class="icon">♪</span><span><strong>TikTok</strong><small>Videos & creators</small></span>
        </a>
        <a class="card" href="https://www.instagram.com/">
          <span class="icon">◎</span><span><strong>Instagram</strong><small>Photos & messages</small></span>
        </a>
        <a class="card" href="https://www.twitch.tv/">
          <span class="icon">▣</span><span><strong>Twitch</strong><small>Live streams</small></span>
        </a>
      </div>
    </section>

    <section>
      <h2>Games</h2>
      <div class="grid">
        <a class="card" href="https://www.roblox.com/">
          <span class="icon">◇</span><span><strong>Roblox</strong><small>Play & create</small></span>
        </a>
        <a class="card" href="https://poki.com/">
          <span class="icon">🎮</span><span><strong>Poki</strong><small>Online games</small></span>
        </a>
        <a class="card" href="https://www.crazygames.com/">
          <span class="icon">🕹️</span><span><strong>CrazyGames</strong><small>Browser games</small></span>
        </a>
        <a class="card" href="https://www.chess.com/">
          <span class="icon">♟</span><span><strong>Chess.com</strong><small>Play chess</small></span>
        </a>
      </div>
    </section>

    <section>
      <h2>Learn & Create</h2>
      <div class="grid">
        <a class="card" href="https://www.wikipedia.org/">
          <span class="icon">W</span><span><strong>Wikipedia</strong><small>Explore knowledge</small></span>
        </a>
        <a class="card" href="https://www.khanacademy.org/">
          <span class="icon">✦</span><span><strong>Khan Academy</strong><small>Learn for free</small></span>
        </a>
        <a class="card" href="https://docs.google.com/">
          <span class="icon">▤</span><span><strong>Google Docs</strong><small>Documents</small></span>
        </a>
        <a class="card" href="https://chatgpt.com/">
          <span class="icon">✳</span><span><strong>ChatGPT</strong><small>Ask & explore</small></span>
        </a>
      </div>
    </section>

    <footer>
      This is a shortcut page, not a separate web browser. Sites open normally and remain subject
      to your school’s Chromebook and network rules. External websites have their own privacy policies.
    </footer>
  </main>

  <script>
    document.getElementById("searchForm").addEventListener("submit", function (event) {
      event.preventDefault();
      const query = document.getElementById("query").value.trim();
      const engine = document.getElementById("engine").value;

      if (query) {
        window.location.href = engine + encodeURIComponent(query);
      }
    });
  </script>
</body>
</html>
